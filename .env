# Build-time configuration. Committed on purpose.
#
# Vite inlines import.meta.env at build time, so these must exist when `vite build`
# runs -- locally and in CI. They were previously only in the gitignored
# .env.local, so every CI build shipped a board with no Supabase connection at all.
#
# These three values are SAFE TO COMMIT: the project URL and the publishable key
# are public by design (the key replaces the old anon JWT, which was equally public
# and equally RLS-scoped). They ship in the client bundle regardless.
#
# The ingest token is NOT here and must never be. Anything in a VITE_ variable is
# compiled into the public bundle; the token is typed into the kiosk Connection
# panel and lives only in the booth laptop localStorage.
#
# .env.local (gitignored) still overrides anything set here.

VITE_SUPABASE_URL=https://ihpmgvepzhczvbtfiaoj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Q-H15u5C7wumhZgfp_niCw_J4wFmT9I
VITE_BOARDING_DATASET=expo-demo
