# Public board connection. Copy to .env.local and fill in from
# Supabase dashboard -> Project Settings -> API.
# Without these the board still works; it just shows no live counts.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: dataset the public board reads. Overridable per page with
# ?dataset=some-other-dataset. Defaults to expo-demo when unset.
VITE_BOARDING_DATASET=expo-demo

# The ingest token is deliberately NOT an env var: anything in a VITE_ variable is
# compiled into the public bundle. Type it into the kiosk page's Connection panel
# instead, where it is stored only in the booth laptop's localStorage.
