# Loaded only by `npm run verify:identity` (vite-node --mode verify).
#
# The identity guard needs envConnection() to return a real object. Without these it
# returns null, and `null === null` would make the check pass while testing nothing --
# which is exactly what happened the first time this ran in CI.
#
# These values are deliberately fake. The guard only compares object identity, never
# the contents, so nothing here needs to be real. Mode `verify` also outranks
# `.env.local`, so the check behaves identically on a laptop and on a runner.
VITE_SUPABASE_URL=https://verify.invalid
VITE_SUPABASE_ANON_KEY=verify-only-not-a-real-key
